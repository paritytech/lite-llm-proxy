# ============================================================================
# Team LLM Proxy — secrets template.
# Copy to .env ON THE BOX, fill every REPLACE_* value, chmod 600. NEVER commit .env.
# ============================================================================

# Admin master key. MUST start with "sk-". Logs into /ui and mints/revokes keys.
LITELLM_MASTER_KEY=sk-REPLACE_WITH_LONG_RANDOM

# Encrypts provider keys stored in Postgres. Set ONCE — never rotate after launch.
LITELLM_SALT_KEY=sk-REPLACE_WITH_LONG_RANDOM

# Postgres password. MUST match the password inside DATABASE_URL below.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM

# LiteLLM → Postgres over the internal docker network (host "postgres", db "litellm").
DATABASE_URL=postgresql://litellm:REPLACE_WITH_LONG_RANDOM@postgres:5432/litellm

# Upstream Kimi / Moonshot key. NEVER exposed to teammates.
MOONSHOT_API_KEY=sk-REPLACE_WITH_MOONSHOT_KEY

# International platform. Use https://api.moonshot.cn/v1 for the China platform.
MOONSHOT_API_BASE=https://api.moonshot.ai/v1

# Upstream OpenRouter key (sk-or-v1-...). NEVER exposed to teammates.
# Recommended: set a credit limit on this key in the OpenRouter dashboard.
OPENROUTER_API_KEY=sk-or-REPLACE_WITH_OPENROUTER_KEY

# API key of the self-hosted vLLM pod (config.yaml "deepseek-flash", RUNBOOK § I).
# vLLM only enforces a key if launched with --api-key; if the pod wasn't, any
# non-empty value works (LiteLLM just needs the variable set). NEVER exposed to
# teammates either way.
VLLM_API_KEY=REPLACE_WITH_VLLM_KEY_OR_DUMMY

# Admin UI login at /ui (proper username/password instead of pasting the master key).
# The master key still works as a fallback login.
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_LONG_RANDOM

# ---- Request-log export (scripts/export-logs.sh) ----
# Where the nightly JSONL training corpus lands. A plain host directory — outside
# Docker, so it survives restarts, redeploys and image bumps. Point it at a mounted
# datastore later without touching anything else.
LOG_EXPORT_DIR=/opt/team-llm/logs

# Days of exported JSONL to keep. EMPTY = keep forever (default — the corpus is the
# point). Set a number (e.g. 90) only if disk pressure ever demands pruning.
LOG_EXPORT_RETENTION_DAYS=

# Secret salt for the corpus "session" pseudonym (md5(salt || session_id)) — lets
# training group the turns of one conversation without exporting raw session ids
# (client-chosen; can embed identity). Generate once with `openssl rand -hex 32`.
# NEVER rotate: rotation unlinks sessions spanning the rotation date, and the salt
# is what keeps the hashes non-reversible — treat it like the other secrets here.
LOG_EXPORT_SESSION_SALT=REPLACE_WITH_OPENSSL_RAND_HEX_32
