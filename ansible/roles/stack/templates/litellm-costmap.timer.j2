[Unit]
Description=Nightly LiteLLM price-map refresh

[Timer]
OnCalendar=*-*-* 03:30:00
# Spread the request rather than hitting GitHub's raw endpoint on the dot.
RandomizedDelaySec=15m
# Catch up after a reboot that spanned the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
