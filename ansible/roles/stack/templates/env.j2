# MANAGED BY ANSIBLE — ansible/roles/stack/templates/env.j2, values from the
# encrypted vault. Editing this file on the box is pointless: the next run
# overwrites it. Change ansible/group_vars/all/vault.yml instead.
#
# Read by docker compose (for ${POSTGRES_PASSWORD}) and handed to the LiteLLM
# container wholesale via env_file.

# Admin master key: logs into /ui and mints/revokes virtual keys.
LITELLM_MASTER_KEY={{ litellm_master_key }}

# Encrypts what the admin UI writes to Postgres — the model menu included.
# Never rotate on a live deployment.
LITELLM_SALT_KEY={{ litellm_salt_key }}

POSTGRES_PASSWORD={{ postgres_password }}
# Derived from the same value, url-encoded: a password containing @ / : or #
# would otherwise silently truncate the connection string.
DATABASE_URL=postgresql://litellm:{{ postgres_password | urlencode }}@postgres:5432/litellm

# ---- Upstream providers ----------------------------------------------------
# Referenced from the admin UI as os.environ/<NAME> so that the model rows in
# Postgres carry a reference, never the credential itself.
MOONSHOT_API_KEY={{ moonshot_api_key }}
MOONSHOT_API_BASE={{ moonshot_api_base }}
OPENROUTER_API_KEY={{ openrouter_api_key }}
VLLM_API_KEY={{ vllm_api_key }}

# ---- Admin UI login --------------------------------------------------------
UI_USERNAME={{ ui_username }}
UI_PASSWORD={{ ui_password }}
